# Railway Production Environment Variables
# Copy these to your Railway service environment variables

# Database (Railway PostgreSQL)
# For local testing, use: postgresql+asyncpg://user:password@localhost:5432/dbname
DATABASE_URL=postgresql+asyncpg://postgres:eLQJYwHgCpUNWyEvRYuuZZRheDMuSJOy@postgres.railway.internal:5432/railway

# Alembic will use this for migrations
# Railway automatically runs migrations on deploy

# Security (CHANGE THESE IN PRODUCTION)
SECRET_KEY=your-super-secret-key-change-this-in-production-railway
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment
ENVIRONMENT=production

# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=Procurement Platform
PROJECT_VERSION=1.0.0

# CORS (Add your Railway domain)
BACKEND_CORS_ORIGINS=["https://your-app.railway.app","http://localhost:3000"]

# AI Integration (Optional - disable if not using)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama

# Redis (Railway Redis addon)
REDIS_URL=redis://default:password@redis.railway.internal:6379
CELERY_BROKER_URL=redis://default:password@redis.railway.internal:6379
CELERY_RESULT_BACKEND=redis://default:password@redis.railway.internal:6379

# Port (Railway sets this automatically)
PORT=8000