{
	"info": {
		"name": "Advertisement API Tests",
		"description": "Test collection for Advertisement API endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api/v1"
		},
		{
			"key": "admin_token",
			"value": ""
		},
		{
			"key": "user_token",
			"value": ""
		}
	],
	"item": [
		{
			"name": "1. Register Admin User",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 201) {",
							"    const response = pm.response.json();",
							"    pm.collectionVariables.set('admin_token', response.token.access_token);",
							"}"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"admin@platform.com\",\n  \"password\": \"admin123\",\n  \"first_name\": \"Admin\",\n  \"last_name\": \"User\",\n  \"role\": \"admin\",\n  \"company\": {\n    \"name\": \"Platform Admin\",\n    \"description\": \"Platform administration\"\n  }\n}"
				},
				"url": {
					"raw": "{{base_url}}/auth/register",
					"host": ["{{base_url}}"],
					"path": ["auth", "register"]
				}
			}
		},
		{
			"name": "2. Register Regular User",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 201) {",
							"    const response = pm.response.json();",
							"    pm.collectionVariables.set('user_token', response.token.access_token);",
							"}"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"user@techcompany.com\",\n  \"password\": \"user123\",\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"role\": \"buyer\",\n  \"company\": {\n    \"name\": \"Tech Solutions Inc\",\n    \"description\": \"Technology and software solutions provider\"\n  }\n}"
				},
				"url": {
					"raw": "{{base_url}}/auth/register",
					"host": ["{{base_url}}"],
					"path": ["auth", "register"]
				}
			}
		},
		{
			"name": "3. Create Advertisement (Admin)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{admin_token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"title\": \"Premium Office Solutions\",\n  \"content\": \"Get the best office equipment and furniture for your business. Special discounts available for technology companies!\",\n  \"image_url\": \"https://example.com/office-ad.jpg\",\n  \"target_industries\": [\"technology\", \"software\", \"consulting\"]\n}"
				},
				"url": {
					"raw": "{{base_url}}/ads/",
					"host": ["{{base_url}}"],
					"path": ["ads", ""]
				}
			}
		},
		{
			"name": "4. Create Ad as User (Should Fail)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{user_token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"title\": \"Test Ad\",\n  \"content\": \"This should fail - only admins can create ads\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/ads/",
					"host": ["{{base_url}}"],
					"path": ["ads", ""]
				}
			}
		},
		{
			"name": "5. Get Targeted Ads",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{user_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/ads/targeted",
					"host": ["{{base_url}}"],
					"path": ["ads", "targeted"]
				}
			}
		},
		{
			"name": "6. Get Targeted Ads with Limit",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{user_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/ads/targeted?limit=3",
					"host": ["{{base_url}}"],
					"path": ["ads", "targeted"],
					"query": [
						{
							"key": "limit",
							"value": "3"
						}
					]
				}
			}
		},
		{
			"name": "7. Create Cloud Services Ad",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{admin_token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"title\": \"Cloud Migration Services\",\n  \"content\": \"Migrate to the cloud with our expert services. 30% off first year for technology companies!\",\n  \"target_industries\": [\"technology\", \"finance\"]\n}"
				},
				"url": {
					"raw": "{{base_url}}/ads/",
					"host": ["{{base_url}}"],
					"path": ["ads", ""]
				}
			}
		},
		{
			"name": "8. Create General Business Ad",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{admin_token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"title\": \"General Business Solutions\",\n  \"content\": \"Complete business solutions for all industries. Contact us today!\",\n  \"target_industries\": []\n}"
				},
				"url": {
					"raw": "{{base_url}}/ads/",
					"host": ["{{base_url}}"],
					"path": ["ads", ""]
				}
			}
		},
		{
			"name": "9. Get All Targeted Ads (Final)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{user_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/ads/targeted",
					"host": ["{{base_url}}"],
					"path": ["ads", "targeted"]
				}
			}
		}
	]
}